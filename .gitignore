# Dependencies and build output
node_modules/
dist/
dist-ssr/
build/
.vite/
.cache/
.tmp-*
vite.config.*.timestamp-*
*.tsbuildinfo

# Environment files (keep a template if one is ever added)
.env*
!.env.example

# Logs
logs/
*.log
*-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local tooling and AI-assistant working files
.claude/
.claude-replay.*
.impeccable/
.superpowers/

# Large source material: original SVG exports and raw image extractions.
# Only the optimised WebP files in public/images/projects are part of the site.
/assets/

# Figma Make and platform-managed state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.figma/design-context/
/.plugins/
/.opencode-skills/
